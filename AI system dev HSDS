function Tag({ color, children }) {
  return (
    <span style={{
      fontSize: 9, padding: "2px 8px", borderRadius: 2, marginLeft: 8,
      border: `1px solid ${color}44`, background: `${color}18`, color,
      fontFamily: "monospace", letterSpacing: 1,
    }}>{children}</span>
  );
}

function Callout({ type = "info", children }) {
  const map = { info: C.mem, ok: C.ok, warn: C.warn, fail: C.fail, store: C.store, screen: C.screen };
  const col = map[type] || C.mem;
  return (
    <div style={{
      borderLeft: `3px solid ${col}`, background: `${col}0d`,
      borderRadius: 3, padding: "10px 14px", margin: "12px 0",
      fontSize: 11, lineHeight: 1.7, color: col,
    }}>{children}</div>
  );
}

function Card({ title, badge, badgeColor = C.mem, dotColor, children, defaultOpen = false }) {
  const [open, setOpen] = useState(defaultOpen);
  return (
    <div style={{ border: `1px solid ${C.border}`, borderRadius: 5, marginBottom: 10, background: C.surface, overflow: "hidden" }}>
      <div onClick={() => setOpen(!open)} style={{
        display: "flex", alignItems: "center", gap: 10, padding: "11px 14px",
        cursor: "pointer", borderBottom: open ? `1px solid ${C.border}` : "none",
      }}>
        {dotColor && <div style={{ width: 8, height: 8, borderRadius: "50%", background: dotColor, flexShrink: 0 }} />}
        <span style={{ flex: 1, fontSize: 12, color: "#b0c4de" }}>{title}</span>
        {badge && (
          <span style={{
            fontSize: 9, padding: "2px 7px", borderRadius: 2,
            border: `1px solid ${badgeColor}44`, color: badgeColor,
            background: `${badgeColor}10`, flexShrink: 0, letterSpacing: 1,
          }}>{badge}</span>
        )}
        <span style={{ color: C.muted, fontSize: 10 }}>{open ? "▲" : "▼"}</span>
      </div>
      {open && <div style={{ padding: 16 }}>{children}</div>}
    </div>
  );
}

function Table({ cols, rows }) {
  return (
    <div style={{ overflowX: "auto", margin: "10px 0" }}>
      <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 11 }}>
        <thead>
          <tr>{cols.map(c => (
            <th key={c} style={{ background: "#0c1220", color: C.muted, padding: "7px 10px", textAlign: "left", fontSize: 9, letterSpacing: 2, borderBottom: `1px solid ${C.border}` }}>{c}</th>
          ))}</tr>
        </thead>
        <tbody>
          {rows.map((row, i) => (
            <tr key={i}>{row.map((cell, j) => (
              <td key={j} style={{ padding: "7px 10px", borderBottom: `1px solid ${C.border}`, color: j === 0 ? C.text : C.muted, fontSize: 11, lineHeight: 1.6 }}
                dangerouslySetInnerHTML={{ __html: cell }} />
            ))}</tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

function Pre({ children }) {
  return (
    <pre style={{
      background: "#04070f", border: `1px solid ${C.border}`, borderLeft: `3px solid ${C.mem}`,
      borderRadius: 4, padding: 16, margin: "12px 0", fontSize: 10.5,
      lineHeight: 1.8, overflowX: "auto", color: "#93c5fd", fontFamily: "monospace",
    }}>{children}</pre>
  );
}

function H2({ children }) {
  return <h2 style={{ fontFamily: "sans-serif", fontSize: 20, fontWeight: 700, color: "#fff", margin: "0 0 8px" }}>{children}</h2>;
}
function H3({ children }) {
  return <h3 style={{ fontFamily: "sans-serif", fontSize: 14, fontWeight: 600, color: "#c8d8f0", margin: "22px 0 8px" }}>{children}</h3>;
}
function H4({ children }) {
  return <div style={{ fontSize: 9, letterSpacing: 3, color: C.muted, textTransform: "uppercase", margin: "14px 0 6px", borderBottom: `1px solid ${C.border}`, paddingBottom: 4 }}>{children}</div>;
}
function P({ children, style }) {
  return <p style={{ fontSize: 12, lineHeight: 1.85, color: "#7a93b8", margin: "0 0 10px", ...style }}>{children}</p>;
}
function Code({ children }) {
  return <code style={{ background: "#0a1020", border: `1px solid ${C.border}`, padding: "1px 5px", borderRadius: 2, fontSize: 10, color: "#7dd3fc", fontFamily: "monospace" }}>{children}</code>;
}
function Ul({ items }) {
  return (
    <ul style={{ listStyle: "none", margin: "8px 0 12px", padding: 0 }}>
      {items.map((it, i) => (
        <li key={i} style={{ fontSize: 12, color: "#7a93b8", lineHeight: 1.75, padding: "2px 0 2px 16px", position: "relative" }}>
          <span style={{ position: "absolute", left: 0, color: C.mem }}>›</span>
          <span dangerouslySetInnerHTML={{ __html: it }} />
        </li>
      ))}
    </ul>
  );
}
function Meter({ label, value, pct, color, note }) {
  return (
    <div style={{ background: "#0c1220", border: `1px solid ${C.border}`, borderRadius: 4, padding: 14 }}>
      <div style={{ fontSize: 9, letterSpacing: 2, color: C.muted, marginBottom: 5 }}>{label}</div>
      <div style={{ fontFamily: "sans-serif", fontSize: 22, fontWeight: 700, color, lineHeight: 1, marginBottom: 6 }}>{value}</div>
      <div style={{ background: "#1a2640", height: 3, borderRadius: 2, overflow: "hidden", marginBottom: 4 }}>
        <div style={{ width: `${pct}%`, height: "100%", background: color, borderRadius: 2 }} />
      </div>
      <div style={{ fontSize: 9, color: C.muted, lineHeight: 1.5 }}>{note}</div>
    </div>
  );
}

